// ---------------------------------------------------------------------------
// abilities.ron — every ability in the game, and who casts what.
//
//   * `defs`             — the ability table. `name` is the stable id: the
//                          catalog key, the bridge selector, the button
//                          caption. Field meanings are on `AbilityDef` in
//                          src/shared.rs.
//
//                          `effects` is the ABILITY'S SENTENCE: a list of
//                          clauses, each `(atom: …, schedule: …)`, applied in
//                          order from one resolved centre. `schedule`
//                          defaults to `Instant`, so a row that means "now"
//                          says nothing at all.
//
//                            atoms     Damage(amount, targets?)
//                                      Heal(amount, targets?)
//                                      ApplyStatus(status, magnitude,
//                                                  duration, targets)
//                                      Militia(duration, targets?)
//                                      Summon(unit_kind, count, lifetime?)
//                                      Teleport(destination, army_only?)
//                            schedules Instant
//                                      OverTime(interval, ticks)  — first
//                                        tick lands at the cast
//
//                          `targets` is per-atom (`Enemies` / `Allies` /
//                          `OwnWorkers`) and defaults to the only side the
//                          atom sensibly has, so one cast can damage enemies
//                          and mend allies. The FIRST atom AIMS the cast: the
//                          auto-pick and the auto-cast trigger both count
//                          whoever atom 0 is looking for. Put the clause the
//                          ability is ABOUT first.
//
//                          The loader refuses nonsense by name at startup —
//                          an empty `effects`, a summoned hero, a thrown
//                          recall, a repeating teleport, militia raised from
//                          the enemy's workers, one status applied twice, a
//                          schedule with no machinery behind it. Compose
//                          freely; the validator is the safety net, and
//                          `check_values` in src/data.rs is the full list.
//                          `target` is OPTIONAL and defaults to `Caster` —
//                          the effect centres on whoever cast it, which is
//                          what every row meant before geometry existed. A
//                          thrown spell says `target: Point(range: 9.0)`; a
//                          single-target one says `target: Unit(range: 9.0)`.
//                          `range` is caster-to-centre and `radius` blooms
//                          from there, so total reach is range + radius, and
//                          the loader refuses a targeted row whose range is
//                          not positive.
//   * `unit_casters`     — per `UnitKind`, the abilities it can ever cast, IN
//                          SLOT ORDER. An ability's index in this list is its
//                          handle everywhere (hotkey slot, cooldown slot,
//                          autocast rule, bridge selector), so append, never
//                          insert. A kind with no record here casts nothing.
//   * `probe_abilities`  — appended to `abilities` only under
//                          `WC3_STATUS_PROBE=1`. Dev instrumentation; never
//                          present in a normal run.
//   * `autocast`         — the standing doctrine a freshly trained unit of
//                          this kind is BORN with, named by ability rather
//                          than by slot index so a row inserted ahead of it
//                          moves the rule with it.
//   * `building_casters` — per building LADDER ROOT. A Keep and a Castle
//                          inherit the TownHall's row, because an upgrade must
//                          never take an ability away from the player who paid
//                          for it.
//
// Content beads add abilities by adding rows here. No code changes.
// ---------------------------------------------------------------------------
(
    defs: [
        // The Champion slams the ground. Flyers overhead feel nothing — the
        // melee hero's air answer is his archers, not his ability. These four
        // numbers are also what `hero_ability_cost/cooldown/radius/damage`
        // report to ai.rs; there is no second copy of them in code.
        (
            name: "Slam",
            effects: [
                (atom: Damage(amount: 45.0)),
            ],
            mana_cost: 40.0,
            cooldown: 10.0,
            radius: 7.0,
            hits_air: false,
            unlock: Always,
            description: "AoE damage around the Champion (ground only), scales with level.",
        ),
        // Healing light reaches up: air allies are still your allies.
        (
            name: "Heal",
            effects: [
                (atom: Heal(amount: 60.0)),
            ],
            mana_cost: 45.0,
            cooldown: 12.0,
            radius: 8.0,
            hits_air: true,
            unlock: Always,
            description: "Restores HP to all allies around the Priestess, air included, scales with level.",
        ),
        // Workers are ground units, so this never had an air question.
        (
            name: "CallToArms",
            // The one atom that TRANSFORMS a body instead of creating,
            // hurting, mending or moving one — see `EffectAtom::Militia` for
            // why it is not a `Summon`.
            effects: [
                (atom: Militia(duration: 40.0)),
            ],
            mana_cost: 0.0,
            cooldown: 90.0,
            radius: 16.0,
            hits_air: false,
            unlock: Always,
            description: "Own workers near the TownHall become fighters for 40s.",
        ),
        // --- hero ultimates: the second ability of each class, at level 5 ---
        //
        // Both are pure table rows: an `ApplyStatus` atom at `Allies`, a `HeroLevel(5)`
        // predicate, their own cooldown slot. Nothing in combat.rs, ui.rs,
        // doctrine.rs or bridge.rs knows their names.
        //
        // They are also the reason a leveled hero is worth a war of its own. A
        // team that keeps its Champion alive to level 5 gets a 45s army-wide
        // damage spike; a team that kills it takes that away for the whole
        // revive-and-relevel arc.
        //
        // Champion ultimate. Radius and duration are tuned so it is an
        // ENGAGEMENT button, not a permanent aura: 8s of +30% inside 8 units,
        // once every 45s. A shout carries — unlike the Slam this is not a
        // ground shockwave, so the team's air units are inside the buff like
        // everyone else.
        (
            name: "Warcry",
            effects: [
                (atom: ApplyStatus(status: DamageBuff, magnitude: 0.30, duration: 8.0, targets: Allies)),
            ],
            mana_cost: 75.0,
            cooldown: 45.0,
            radius: 8.0,
            hits_air: true,
            unlock: HeroLevel(5),
            description: "Ultimate: allies around the Champion deal +30% damage for 8s. Hero level 5.",
        ),
        // Priestess ultimate: the two-status row. 15 HP/s is roughly a
        // Footman's health bar over the full 6s, and the 25% reduction is what
        // makes the heal out-race incoming fire instead of merely trailing it.
        // Under v2 this row needed a bespoke `also` field, because "two
        // statuses on one button" had nowhere else to live. Under v3 it is
        // simply a two-atom row, and the field is gone.
        (
            name: "Sanctuary",
            // **The row `also` existed for, now written as what it always
            // was: two clauses of one sentence.** Same centre, same radius,
            // same 6 seconds, two statuses — and the schema is no longer
            // holding a place for a third.
            effects: [
                (atom: ApplyStatus(status: HealOverTime, magnitude: 15.0, duration: 6.0, targets: Allies)),
                (atom: ApplyStatus(status: ArmorBuff,    magnitude: 0.25, duration: 6.0, targets: Allies)),
            ],
            mana_cost: 90.0,
            cooldown: 60.0,
            radius: 7.0,
            hits_air: true,
            unlock: HeroLevel(5),
            description: "Ultimate: allies around the Priestess regain 15 HP/s and take 25% less damage for 6s. Hero level 5.",
        ),
        // The Sorcerer's Slow: the game's first shipping crowd control, and a
        // pure table row — no new effect variant, no new system, no new
        // component.
        //
        // Tuning notes, because every number here is a balance decision:
        //
        //   * magnitude 0.4 — a Raider drops from 10.5 to 6.3 speed (slower
        //     than a Footman) and its 1.1s swing becomes 1.83s. That is what
        //     "cripples a charge" has to mean: the dive still happens, it just
        //     arrives late and hits at two thirds rate. `StackPolicy::Refresh`
        //     means a second Sorcerer refreshes rather than compounds, so
        //     massed casters can never approach the 0.75 cap and stun the
        //     field.
        //   * duration 5s against a 9s cooldown — a 55% uptime on one
        //     Sorcerer. Long enough to decide a collision, short enough that a
        //     retreat covered by Slow is a real cost in tempo.
        //   * target: Point(range: 9.0) with radius 4.5 — the number that
        //     changed when geometry became data. Slow shipped as a radius-8
        //     bubble centred on the Sorcerer, inflated to 8 purely because
        //     there was no other way to reach the enemy; the arena finding was
        //     the predictable one, that a Sorcerer who must stand within 8 of
        //     a charge to slow it is a Sorcerer standing in the charge.
        //     Targeted, the same spell is thrown 9 ahead and blooms 4.5 wide,
        //     so its far edge reaches 13.5 — a longer reach than the bubble
        //     ever had, from 9 further back, with a footprint barely a third
        //     of the area. It is a better spell and a strictly worse blanket,
        //     which is the trade a targeted AoE is supposed to make: it has to
        //     be AIMED, and a bad aim catches nobody. 9 is a shade under the
        //     Sorcerer's own 11 attack range, so the spell never asks the
        //     caster to walk somewhere its attack would not.
        //   * out of range is REFUSED, not walked into — see `AbilityTarget`
        //     in src/shared.rs. Casting from behind your own line is the whole
        //     point, so a caster that closed the gap by itself would undo it.
        //   * no mana — the Sorcerer is not a hero and carries no `Hero`
        //     component, so its only gate is `AbilityCooldowns`.
        //   * hits_air: true — this is a hex, not a shockwave.
        //   * unlock: Always — the tech gate is the Sanctum (which requires a
        //     Keep), so gating the spell on `TeamTier` as well would be the
        //     same rule written twice, and would silently disarm every
        //     Sorcerer alive the moment a team's Keep fell.
        //   * one atom — Slow is one debuff and nothing else.
        (
            name: "Slow",
            effects: [
                (atom: ApplyStatus(status: Slow, magnitude: 0.4, duration: 5.0, targets: Enemies)),
            ],
            target: Point(range: 9.0),
            mana_cost: 0.0,
            cooldown: 9.0,
            radius: 4.5,
            hits_air: true,
            unlock: Always,
            description: "Cast at a point up to 9 away: slows every enemy within 4.5 of it by 40% (move AND attack speed) for 5s. Refreshes rather than stacks; no mana, 9s cooldown. Omit the point and the Sorcerer aims at the biggest clump it can reach.",
        ),
        // Dev-only second Champion ability, present only under
        // `WC3_STATUS_PROBE=1`. It exists so a real match can exercise the v2
        // path end to end — a second ability on a caster, a level-gated
        // unlock, its own cooldown slot, an explicit selector, and an
        // `ApplyStatus` effect feeding the status framework — without shipping
        // balance content the content beads have not designed yet.
        //
        // Gated on the TEAM TIER on purpose: this is the live test of the join
        // between the ability framework and the hall ladder. It is locked
        // while a team has only a TownHall and opens the moment its Keep
        // finishes.
        (
            name: "ProbeChill",
            effects: [
                (atom: ApplyStatus(status: Slow, magnitude: 0.4, duration: 6.0, targets: Enemies)),
            ],
            mana_cost: 10.0,
            cooldown: 8.0,
            radius: 9.0,
            hits_air: false,
            unlock: TeamTier(T2),
            description: "Dev probe: slows enemies around the Champion by 40% for 6s. Requires tier 2.",
        ),
        // ------------------------------------------------------------------
        // **THE v3 PROOF.** A mechanic this engine has never had — a thrown
        // nuke that both hurts and chills — added as a ROW.
        //
        // Under v2 this ability was unbuildable without Rust: `AbilityEffect`
        // was a closed enum with one variant per mechanic, so "damage AND
        // slow" needed a new variant, a new arm in combat.rs's applier, a new
        // arm in doctrine.rs's counter, and a new arm in the catalog. Under v3
        // it is two atoms in a list, and the diff that added it is this
        // comment and the eight lines below it. Nothing in src/ knows the word
        // "FrostNova"; grep for it and the only hits are this file and the
        // tests that assert exactly that.
        //
        // Order is load-bearing and is the reason `Damage` is written first:
        // atom 0 AIMS the cast (see `AbilityDef::aim`), so this spell centres
        // on the biggest clump of enemies its damage would catch, and the slow
        // rides along to the same clump. Written the other way round it would
        // aim identically here — both atoms want Enemies — but a row whose
        // clauses disagree about who they are for should put the one it is
        // ABOUT first.
        //
        // Dev-gated: listed only in the Champion's `probe_abilities`, so it
        // exists under `WC3_STATUS_PROBE=1` and in no shipping match. The
        // numbers below are therefore a demonstration, not a balance
        // proposal — the content bead that ships a nuke will pick its own.
        (
            name: "FrostNova",
            effects: [
                (atom: Damage(amount: 60.0)),
                (atom: ApplyStatus(status: Slow, magnitude: 0.35, duration: 4.0, targets: Enemies)),
            ],
            target: Point(range: 9.0),
            mana_cost: 60.0,
            cooldown: 12.0,
            radius: 4.0,
            hits_air: true,
            unlock: Always,
            description: "Dev demo: thrown up to 9 away, deals 60 damage and slows every enemy within 4 by 35% for 4s. Defined entirely in abilities.ron — no Rust knows its name.",
        ),
    ],

    unit_casters: [
        // Heroes deliberately have NO default autocast: their mana is a
        // resource a player budgets, and a hero that spends it the instant one
        // enemy wanders past is a hero with none left for the fight.
        (kind: Hero,      abilities: ["Slam", "Warcry"],   probe_abilities: ["ProbeChill", "FrostNova"], autocast: None),
        (kind: Priestess, abilities: ["Heal", "Sanctuary"], probe_abilities: [],            autocast: None),
        // One enemy in the bubble is enough: the cooldown is the only cost,
        // and a Slow landed on a single Raider diving your workers is exactly
        // the moment the unit was built for. A caster whose entire value is
        // one debuff is worthless as a statue.
        //
        // v3 note for the balance bead: "in reach" grew when Slow became a
        // thrown spell — from "within 8 of the caster" to "within 9 + 4.5",
        // roughly a 70% longer trigger. min_targets is deliberately left at 1
        // anyway, because the auto-pick always centres on the BIGGEST clump it
        // can reach, so a lone scout only wastes the cooldown when it is the
        // only thing on the field. If arena data says Sorcerers are caught on
        // cooldown when the real charge lands, this number — not the geometry
        // — is the knob.
        (kind: Sorcerer,  abilities: ["Slow"],              probe_abilities: [],            autocast: Some((ability: "Slow", min_targets: 1))),
    ],

    // Keyed by ladder ROOT: the Keep and the Castle inherit this row.
    building_casters: [
        (kind: TownHall, abilities: ["CallToArms"]),
    ],
)
