// ---------------------------------------------------------------------------
// units.ron — the unit stat table.
//
// One record per `UnitKind` variant, every variant exactly once; the loader
// (src/data.rs) refuses to start otherwise, naming the variant it could not
// find. Field meanings are documented on `UnitStats` in src/shared.rs; the
// balance rationale lives here, next to the number it explains.
//
// Anti-air is decided by ONE rule, applied to every kind below: a weapon that
// leaves the hand can hit a flyer, a weapon swung by hand cannot. So archers,
// the Priestess and towers shoot air; footmen, raiders, workers, militia and
// the melee Champion cannot. Catapults are the deliberate exception to
// "projectile == anti-air": siege is a ground bombardment weapon, and keeping
// it air-blind is what makes flyers the clean counter to a siege push (which
// is in turn the counter to the tower turtle flyers also bypass). Every
// counter has a counter.
//
// `requires` is the TECH gate beyond owning the trainer building; the trainer
// itself is `trains` in buildings.ron.
//
// `races` is which rosters may field the row. An ABSENT or empty `races` means
// NEUTRAL — every race — which is why every Kingdom row below spells its race
// out: a unit that belongs to nobody belongs to everybody. The loader's
// race-tree validator (src/data.rs `check_races`) refuses to start if any race
// is missing a worker, a hall ladder, supply, production, an army that can
// reach the win condition, or the anti-cavalry leg of its own triangle.
//
// `role` is what the row is FOR, race-independently. It is not decoration:
// `is_hero_kind`, `TargetClass::of` and the scripted commander's roster lookup
// all read it instead of matching on a kind, which is what makes the
// counter-triangle hold ACROSS races for free — both rosters' cavalry declare
// `role: Cavalry`, so both rosters' spears take 5x off them.
// ---------------------------------------------------------------------------
[
    (
        kind: Worker,
        races: [Kingdom],
        role: Worker,
        name: "Worker",
        description: "Harvests gold/lumber, constructs buildings. Fights poorly.",
        requires: [],
        stats: (
            cost_gold: 75, cost_lumber: 0, supply: 1, hp: 60.0, damage: 5.0,
            range: 1.8, attack_cooldown: 1.5, speed: 8.0, train_time: 8.0, projectile: false,
            vs_building_mult: 1.0, vs_siege_mult: 1.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: false, can_hit_ground: true,
            vision: 12.0,
        ),
    ),
    (
        kind: Footman,
        races: [Kingdom],
        role: Line,
        name: "Footman",
        description: "Cheap melee line unit. Tanks for archers.",
        requires: [],
        stats: (
            cost_gold: 135, cost_lumber: 0, supply: 2, hp: 140.0, damage: 12.0,
            range: 2.0, attack_cooldown: 1.2, speed: 7.0, train_time: 12.0, projectile: false,
            vs_building_mult: 1.0, vs_siege_mult: 1.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: false, can_hit_ground: true,
            vision: 16.0,
        ),
    ),
    // The line's anti-air: a footman screen is helpless overhead, archers
    // behind it are not.
    (
        kind: Archer,
        races: [Kingdom],
        role: Ranged,
        name: "Archer",
        description: "Long-range attacker. Fragile; keep behind footmen.",
        requires: [],
        stats: (
            cost_gold: 90, cost_lumber: 30, supply: 2, hp: 70.0, damage: 14.0,
            range: 14.0, attack_cooldown: 1.5, speed: 7.0, train_time: 12.0, projectile: true,
            vs_building_mult: 1.0, vs_siege_mult: 1.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: true, can_hit_ground: true,
            vision: 18.0,
        ),
    ),
    // Base (level 1) stats; damage/HP grow per level — see `Hero` in shared.rs.
    // The Champion swings a greatsword: no reach into the air, and its Slam is
    // a ground shockwave (see abilities.ron). A team that plays the melee hero
    // needs archers or towers to answer flyers.
    (
        kind: Hero,
        races: [Kingdom],
        role: HeroMelee,
        name: "Hero",
        description: "The Champion: melee hero, levels from nearby enemy deaths, AoE Slam ability. Your team's FIRST hero is FREE (the 25s and the 5 supply are still real, and both are spent at the hall that makes your workers); every hero after it — a second class, or this one back from the dead — costs revive_gold/revive_lumber, which is why that pair doubles as the fielding price. Revival preserves the level. Occupies one hero slot; slots scale with your hall tier (1/2/3) and no team may field two of the same class.",
        requires: [],
        stats: (
            cost_gold: 0, cost_lumber: 0, supply: 5, hp: 320.0, damage: 24.0,
            range: 2.4, attack_cooldown: 1.1, speed: 7.5, train_time: 25.0, projectile: false,
            vs_building_mult: 1.0, vs_siege_mult: 1.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: false, can_hit_ground: true,
            revive_gold: 400, revive_lumber: 100,
            vision: 20.0,
        ),
    ),
    // Outranges towers (20 vs 16) and pulverizes structures, but 15 damage
    // vs units, 110 hp, and 4.5 speed means anything that reaches it wins.
    // Ground-only by design: a boulder lobbed at a wall cannot track a
    // flyer, so an all-in siege push is the thing air raiders punish.
    (
        kind: Catapult,
        races: [Kingdom],
        role: Siege,
        name: "Catapult",
        description: "Siege engine: outranges towers, 6x damage vs buildings, but slow, fragile, and feeble against units. Escort it.",
        requires: [],
        stats: (
            cost_gold: 180, cost_lumber: 120, supply: 3, hp: 110.0, damage: 15.0,
            range: 20.0, attack_cooldown: 3.0, speed: 4.5, train_time: 22.0, projectile: true,
            vs_building_mult: 6.0, vs_siege_mult: 1.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: false, can_hit_ground: true,
            vision: 14.0,
        ),
    ),
    // Speed is the weapon: dives catapults (2x) and worker lines, melts under
    // focused fire. Gold-heavy so it competes with footmen for budget.
    //
    // Round-4 balance: an ungated Raider rush killed 14 workers by t=228
    // before any reactive defense could finish. Workshop-gating makes cavalry
