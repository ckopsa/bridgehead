    (
        kind: Raider,
        races: [Kingdom],
        role: Cavalry,
        name: "Raider",
        description: "Fast cavalry: 2x damage vs Catapults, excels at worker raids and map control. Melts under massed fire.",
        requires: [Workshop],
        stats: (
            cost_gold: 170, cost_lumber: 30, supply: 3, hp: 130.0, damage: 16.0,
            range: 2.2, attack_cooldown: 1.1, speed: 10.5, train_time: 16.0, projectile: false,
            vs_building_mult: 1.0, vs_siege_mult: 2.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: false, can_hit_ground: true,
            vision: 24.0,
        ),
    ),
    // Ranged support hero: heals instead of slams. Base (level 1) stats.
    // Her bolts track upward, so the support hero is also the hero answer to
    // air.
    (
        kind: Priestess,
        races: [Kingdom],
        role: HeroSupport,
        name: "Priestess",
        description: "Support hero: ranged attack, Heal ability (AoE ally healing). Free only if she is your team's first hero ever; standing alongside a Champion costs revive_gold/revive_lumber, the same price her death does — a Keep grants the SLOT, not the hero. Revival preserves the level. Occupies one hero slot.",
        requires: [],
        stats: (
            cost_gold: 0, cost_lumber: 0, supply: 5, hp: 240.0, damage: 14.0,
            range: 10.0, attack_cooldown: 1.4, speed: 7.5, train_time: 25.0, projectile: true,
            vs_building_mult: 1.0, vs_siege_mult: 1.0, vs_cavalry_mult: 1.0,
            flying: false, can_hit_air: true, can_hit_ground: true,
            revive_gold: 400, revive_lumber: 100,
            vision: 18.0,
        ),
